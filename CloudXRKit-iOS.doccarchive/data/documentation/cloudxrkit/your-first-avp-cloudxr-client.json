AppStorage(\"ipAddress\") static var ipAddress: String = \"\"","    @AppStorage(\"resolutionPreset\") private var resolutionPreset: ResolutionPreset = .standardPreset","    ","    var body: some View {","        VStack {","            ","            Form {","                HStack {","                    Text(\"IP Address\")","                    Spacer()","                    TextField(\"0.0.0.0\", text: ContentView.$ipAddress)","                        .autocorrectionDisabled(true)","                        .keyboardType(.numbersAndPunctuation)","                        .textInputAutocapitalization(.never)","                        .searchDictationBehavior(.inline(activation: .onLook))","                        .onSubmit {","                            \/\/ strip whitespace","                            ContentView.ipAddress = ContentView.ipAddress.trimmingCharacters(","                                in: .whitespacesAndNewlines","                            )","                        }","                }","            }","            ","            Model3D(named: \"Scene\", bundle: realityKitContentBundle)","                .padding(.bottom, 50)","","            Button(\"Connect\") {","                Task { @MainActor in","                    var config = CloudXRKit.Config()","                    \/\/ Configure our IP address","                    config.connectionType = .local(ip: ContentView.ipAddress)","                    \/\/ Set the resolution preset to low-resolution for testing; normally use .standardPreset","                    config.resolutionPreset = .standardPreset","                    cxrSession.configure(config: config)","                    \/\/ Connect!","                    try await cxrSession.connect()","                }","            }.padding()","        }","        .padding()","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Streaming-content-from-a-server","type":"heading","text":"Streaming content from a server"},{"inlineContent":[{"text":"In order for CloudXR to stream, it needs the current space to be a RealityKit ImmersiveSpace that is properly “hooked up”.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Create","type":"text"}],"type":"strong"},{"text":" a new empty file (File > New > Empty File) called ","type":"text"},{"code":"ImmersiveView.swift","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"identifier":"empty-file.png","type":"image"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Let’s start with imports and the basic structure of View. ","type":"text"},{"inlineContent":[{"type":"text","text":"Add"}],"type":"strong"},{"text":" the following code to the empty file.","type":"text"}]}]}],"start":2,"type":"orderedList"},{"code":["import SwiftUI","import RealityKit","","import CloudXRKit","","let streamingSpaceTitle = \"CxrStreamingImmersiveSpace\"","","struct ImmersiveView: View {","    var body: some View {","        RealityView { content in","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This view will need to be able to see the CloudXR Session object, just like ","type":"text"},{"type":"codeVoice","code":"ContentView"},{"text":".","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Add the following code inside of "},{"type":"codeVoice","code":"ImmersiveView"},{"type":"text","text":" and before "},{"type":"codeVoice","code":"body"},{"type":"text","text":"."}],"type":"paragraph"}]}],"start":3,"type":"orderedList"},{"code":["@Environment(CloudXRSession.self) var cxrSession"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"code":["...","","struct ImmersiveView: View {","    ","    \/\/ The new section","","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ end of the new Section","    ","    var body: some View {","        ...","    }","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"CloudXR also needs know about the scene and this session, so we need an "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":" to glue it all together. Add the following code after "},{"code":"cxrSession","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"start":4,"type":"orderedList"},{"code":["@State private var sessionEntity = Entity()    "],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"code":["...","","struct ImmersiveView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ The new section","","    @State private var sessionEntity = Entity()","","    \/\/ end of the new section","    ","    var body: some View {","        ...","    }","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, we need to create a "},{"type":"codeVoice","code":"CloudXRSessionComponent"},{"type":"text","text":" in the (at this point, active) scene that knows about the connected "},{"type":"codeVoice","code":"CloudXRSession"},{"type":"text","text":". Add the following code inside of "},{"type":"codeVoice","code":"RealityView"},{"type":"text","text":"."}]}]}],"start":5,"type":"orderedList"},{"code":["sessionEntity.name = \"Session\"","","\/\/ Just a quick check; this View shouldn't be opened unless we're connected.","if cxrSession.state != .connected {","    print(\"Oops, we shouldn't be trying to render CloudXR without being connected!\")","}","","sessionEntity.components[CloudXRSessionComponent.self] = .init(session: cxrSession)","sessionEntity.transform = .init()","content.add(sessionEntity)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This new View is not (yet) being opened. To do that, we need to go back to the main app file ("},{"type":"codeVoice","code":"My_First_AVP_CloudXR_ClientApp.swift"},{"type":"text","text":" or similar) and add it to the end of our Scene."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Go to ","type":"text"},{"type":"codeVoice","code":"My_First_AVP_CloudXR_ClientApp.swift"},{"text":" and add the following code inside of ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" and after ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":".","type":"text"}]}]}],"start":6,"type":"orderedList"},{"code":["ImmersiveSpace(id: streamingSpaceTitle) {","    ImmersiveView()","}",".environment(cxrSession)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Here is a reference on placement:","type":"text"}],"type":"paragraph"},{"code":["...","","@main","struct My_First_AVP_CloudXR_ClientApp: App {","    ","    ...","    ","    var body: some Scene {","        ...","","        WindowGroup {","            ...","        }","        .environment(cxrSession)","","        \/\/ The new section","        ","        ImmersiveSpace(id: streamingSpaceTitle) {","            ImmersiveView()","        }","        .environment(cxrSession)","","        \/\/ end of the new section","    }","}",""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Back in "},{"type":"codeVoice","code":"ContentView.swift"},{"type":"text","text":", we need to "},{"type":"emphasis","inlineContent":[{"text":"open","type":"text"}]},{"type":"text","text":" this ImmersiveSpace once CloudXR is connected which will require us to bring in "},{"type":"codeVoice","code":"openImmersiveSpace"},{"type":"text","text":" from the environment."}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Go to ","type":"text"},{"type":"codeVoice","code":"ContentView.swift"},{"text":", and add the following code after ","type":"text"},{"type":"codeVoice","code":"cxrSession"},{"text":" but before ","type":"text"},{"type":"codeVoice","code":"ipAddress"},{"text":".","type":"text"}],"type":"paragraph"}]}],"start":7,"type":"orderedList"},{"code":["@Environment(\\.openImmersiveSpace) var openImmersiveSpace"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"code":["...","","struct ContentView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","","    \/\/ The new section","","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","","    \/\/ end of the new section","    ","    \/\/ Configurable session settings.","    @AppStorage(\"ipAddress\") static var ipAddress: String = \"\"","    @AppStorage(\"resolutionPreset\") private var resolutionPreset: ResolutionPreset = .standardPreset","    ","    var body: some View {","        ...","    }","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the following code after "},{"type":"codeVoice","code":"try await cxrSession.connect()"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Task"},{"type":"text","text":"."}]}]}],"start":8,"type":"orderedList"},{"code":["await openImmersiveSpace(id: streamingSpaceTitle)"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Here is a reference on placement:"}],"type":"paragraph"},{"code":["...","","struct ContentView: View {","    ","    ...","    ","    var body: some View {","        VStack {","            ","            ...","","            Button(\"Connect\") {","                Task { @MainActor in","                    ...","","                    try await cxrSession.connect()","                    ","                    \/\/ The new section","","                    await openImmersiveSpace(id: streamingSpaceTitle)","","                    \/\/ end of the new section","                }","            }.padding()","        }","        .padding()","    }","}",""],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Make sure your test server is running!"}],"type":"paragraph"},{"inlineContent":[{"text":"💻 Check: 🛠️ Builds, Runs, Connects, Streams!!","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You should see streaming content that appears to be in the “room”.","type":"text"},{"text":" ","type":"text"},{"identifier":"image-5.png","type":"image"}],"type":"paragraph"},{"level":2,"anchor":"MyFirstAVPCloudXRClientAppswift-complete","type":"heading","text":"`My_First_AVP_CloudXR_ClientApp.swift` complete"},{"code":["import SwiftUI","","import CloudXRKit","","@main","struct My_First_AVP_CloudXR_ClientApp: App {","    ","    @State private var cxrSession = CloudXRSession(","        config: CloudXRKit.Config()","    )","","    init() {","        CloudXRKit.registerSystems()","    }","    ","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .environment(cxrSession)","        ","        ImmersiveSpace(id: streamingSpaceTitle) {","            ImmersiveView()","        }","        .environment(cxrSession)","    }","}",""],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"ContentViewswift-complete","type":"heading","text":"`ContentView.swift` complete"},{"code":["import SwiftUI","import RealityKit","import RealityKitContent","","import CloudXRKit","","struct ContentView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","    @Environment(\\.openImmersiveSpace) var openImmersiveSpace","    ","    \/\/ Configurable session settings.","    @AppStorage(\"ipAddress\") static var ipAddress: String = \"\"","    @AppStorage(\"resolutionPreset\") private var resolutionPreset: ResolutionPreset = .standardPreset","    ","    var body: some View {","        VStack {","            ","            Form {","                HStack {","                    Text(\"IP Address\")","                    Spacer()","                    TextField(\"0.0.0.0\", text: ContentView.$ipAddress)","                        .autocorrectionDisabled(true)","                        .keyboardType(.numbersAndPunctuation)","                        .textInputAutocapitalization(.never)","                        .searchDictationBehavior(.inline(activation: .onLook))","                        .onSubmit {","                            \/\/ strip whitespace","                            ContentView.ipAddress = ContentView.ipAddress.trimmingCharacters(","                                in: .whitespacesAndNewlines","                            )","                        }","                }","            }","            ","            Model3D(named: \"Scene\", bundle: realityKitContentBundle)","                .padding(.bottom, 50)","","            Button(\"Connect\") {","                Task { @MainActor in","                    var config = CloudXRKit.Config()","                    \/\/ Configure our IP address","                    config.connectionType = .local(ip: ContentView.ipAddress)","                    \/\/ Set the resolution preset to low-resolution for testing; normally use .standardPreset","                    config.resolutionPreset = .standardPreset","                    cxrSession.configure(config: config)","                    \/\/ Connect!","                    try await cxrSession.connect()","                    ","                    await openImmersiveSpace(id: streamingSpaceTitle)","                }","            }.padding()","        }","        .padding()","    }","}","","#Preview(windowStyle: .automatic) {","    ContentView()","}",""],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"ImmersiveViewswift-complete","type":"heading","text":"`ImmersiveView.swift` complete"},{"code":["import SwiftUI","import RealityKit","","import CloudXRKit","","let streamingSpaceTitle = \"CxrStreamingImmersiveSpace\"","","struct ImmersiveView: View {","    ","    @Environment(CloudXRSession.self) var cxrSession","    @State private var sessionEntity = Entity()","    ","    var body: some View {","        RealityView { content in","            sessionEntity.name = \"Session\"","","            \/\/ Just a quick check; this View shouldn't be opened unless we're connected.","            if cxrSession.state != .connected {","                print(\"Oops, we shouldn't be trying to render CloudXR without being connected!\")","            }","","            sessionEntity.components[CloudXRSessionComponent.self] = .init(session: cxrSession)","            sessionEntity.transform = .init()","            content.add(sessionEntity)","        }","    }","}",""],"syntax":"swift","type":"codeListing"}]}],"identifier":{"url":"doc:\/\/com.nvidia.CloudXRKit\/documentation\/CloudXRKit\/Your-First-AVP-CloudXR-Client","interfaceLanguage":"swift"},"references":{"build-proj.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/com.nvidia.CloudXRKit\/build-proj.png"}],"alt":"TODO: alt text","identifier":"build-proj.png","type":"image"},"xcode-new-project.png":{"identifier":"xcode-new-project.png","alt":"TODO: alt text","variants":[{"traits":["1x","light"],"url":"\/images\/com.nvidia.CloudXRKit\/xcode-new-project.png"}],"type":"image"},"new-proj.png":{"variants":[{"traits":["3x","light"],"url":"\/images\/com.nvidia.CloudXRKit\/new-proj@3x.png"}],"alt":"TODO: alt text","identifier":"new-proj.png","type":"image"},"add-package-dep.png":{"identifier":"add-package-dep.png","alt":"TODO: alt text","variants":[{"traits":["1x","light"],"url":"\/images\/com.nvidia.CloudXRKit\/add-package-dep.png"}],"type":"image"},"image-1.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/com.nvidia.CloudXRKit\/image-1.png"}],"alt":"New IP address box","identifier":"image-1.png","type":"image"},"image-5.png":{"identifier":"image-5.png","alt":"TODO: alt text","va